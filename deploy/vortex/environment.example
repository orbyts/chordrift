# Non-secret deployment identity
CHORDRIFT_IMAGE_TAG=v0.2.1-beta.1-dev
CHORDRIFT_VCS_REF=replace-with-full-commit-sha
CHORDRIFT_BUILD_DATE=2026-08-30T00:00:00Z
CHORDRIFT_SECRETS_FILE=/home/suhail/.config/chordrift-hosted/chordrift.env

# The referenced host-only file contains these values. Never commit it.
# Materialize it from 1Password with:
# deploy/vortex/configure-private-beta.sh vortex
# CHORDRIFT_DATABASE_URL=postgresql://...
# CHORDRIFT_PUBLIC_ORIGIN=https://chordrift.suhail.ink/
# CHORDRIFT_ACCOUNT_ID=existing-chordrift-account-uuid
# CHORDRIFT_SPOTIFY_CLIENT_ID=public-spotify-application-id
# CHORDRIFT_PROVIDER_VAULT_ACTIVE_KEY_ID=external-key-selector
# CHORDRIFT_PROVIDER_VAULT_KEY_B64=base64-encoded-32-byte-key
# CHORDRIFT_BOOTSTRAP_VERIFIED_EMAIL=verified-google-email
# CHORDRIFT_OIDC_ISSUER=https://YOUR_AUTH0_DOMAIN/
# CHORDRIFT_OIDC_AUTHORIZATION_URL=https://YOUR_AUTH0_DOMAIN/authorize
# CHORDRIFT_OIDC_TOKEN_URL=https://YOUR_AUTH0_DOMAIN/oauth/token
# CHORDRIFT_OIDC_USERINFO_URL=https://YOUR_AUTH0_DOMAIN/userinfo
# CHORDRIFT_OIDC_CLIENT_ID=...
# CHORDRIFT_OIDC_CLIENT_SECRET=...
# Public client ID of the separate Auth0 Native application. No secret exists.
# Its enabled grant types must include Device Code.
# CHORDRIFT_OIDC_DEVICE_CLIENT_ID=...
