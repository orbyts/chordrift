{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/orbyts/chordrift/blob/main/docs/playlist-naming-v1.schema.json",
  "title": "Chordrift playlist naming artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generation_id", "context_sha256", "generator", "playlists"],
  "properties": {
    "schema_version": { "const": 1 },
    "generation_id": { "type": "string", "format": "uuid" },
    "context_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "model_version"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 120 },
        "model": { "type": "string", "minLength": 1, "maxLength": 120 },
        "model_version": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "playlists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stable_key", "name", "description", "tags"],
        "properties": {
          "stable_key": { "type": "string", "pattern": "^playlist-[0-9a-f]{12}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": { "type": "string", "minLength": 1, "maxLength": 300 },
          "tags": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 1, "maxLength": 40 }
          }
        }
      }
    }
  }
}
