{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/orbyts/chordrift/blob/main/docs/model-inference-v1.schema.json",
  "title": "Chordrift pretrained audio-model inference manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "model_version", "model_license", "model_revision", "audio_source", "rights_basis", "sample_rate_hz", "aggregation", "tracks"],
  "properties": {
    "schema_version": { "const": 1 },
    "model": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string", "minLength": 1 },
    "model_license": { "type": "string", "minLength": 1 },
    "model_revision": { "type": "string", "minLength": 1 },
    "audio_source": { "const": "local_audio" },
    "rights_basis": { "const": "user_owned_or_authorized_local_audio" },
    "sample_rate_hz": { "type": "integer", "minimum": 8000, "maximum": 192000 },
    "aggregation": { "type": "string", "minLength": 1 },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spotify_id", "input_sha256", "inferred_at", "segment_count"],
        "properties": {
          "spotify_id": { "type": "string", "pattern": "^[A-Za-z0-9]{22}$" },
          "input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "inferred_at": { "type": "string", "format": "date-time" },
          "segment_count": { "type": "integer", "minimum": 1 },
          "embedding": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "type": "number" } },
          "facts": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value", "confidence"],
              "properties": {
                "kind": { "enum": ["genre", "mood", "sound_descriptor"] },
                "value": { "type": "string", "minLength": 1 },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        },
        "anyOf": [
          { "required": ["embedding"] },
          { "required": ["facts"], "properties": { "facts": { "minItems": 1 } } }
        ]
      }
    }
  }
}
